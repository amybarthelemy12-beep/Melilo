# --- Cloudflare R2 / Terraform ---
CLOUDFLARE_API_TOKEN=
TF_VAR_cloudflare_account_id=
TF_VAR_deployment_environment=dev
TF_VAR_source_bucket_name=melilo-legal-source-dev
TF_VAR_pairs_bucket_name=melilo-pairs-dev

# --- R2 credentials ---
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_PUBLIC_BUCKET=govparti-archive
R2_INTERNAL_BUCKET=govparti-internal
R2_MELILO_BUCKET=melilo-pairs
R2_MELILO_ENDPOINT=
R2_SOURCE_BUCKET=melilo-legal-source

# --- Neon ---
NEON_DATABASE_URL=

# --- Model settings ---
TRANSLATOR_MODEL=allenai/OLMo-3-7B-Instruct
STUDENT_MODEL=allenai/OLMo-2-0425-1B-SFT
PROMPT_VERSION=v4-plain-english-grade-5
HF_TOKEN=

# --- Translator backend ---
MELILO_BACKEND=openai
MELILO_BACKEND_CONCURRENCY=2
MELILO_BACKEND_MAX_TOKENS=2048
MELILO_BACKEND_TEMPERATURE=0.0
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama
OPENAI_MODEL=olmo-3:7b-instruct
