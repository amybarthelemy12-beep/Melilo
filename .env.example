# --- Cloudflare R2 (shared credentials for all buckets on the govparti account) ---
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=

# Source buckets (read-from)
R2_PUBLIC_BUCKET=govparti-archive
R2_INTERNAL_BUCKET=govparti-internal
R2_PUBLIC_BASE_URL=https://archive.govparti.org

# Melilo bucket (write-to). Pair JSONL archives land here.
R2_MELILO_BUCKET=melilo-pairs
# Optional: public custom-domain URL for the Melilo bucket. Stored for reference
# only; S3 writes use R2_ENDPOINT + R2_MELILO_BUCKET.
R2_MELILO_ENDPOINT=

# --- Neon (Postgres) for the pair query layer ---
# postgresql://user:password@host/dbname?sslmode=require
NEON_DATABASE_URL=

# --- Models ---
TRANSLATOR_MODEL=allenai/Olmo-3-7B-Instruct
STUDENT_MODEL=allenai/OLMo-2-0425-1B-SFT

# Prompt version tag stored in each pair record. Bump when prompts.py changes.
PROMPT_VERSION=v3-pirac-brief-summary-walkthrough

# Optional: HF token if pulling gated artifacts (OLMo isn't gated).
HF_TOKEN=

# --- Translator backend ---
# `hf`     : load HF transformers in-process. Default; needs a GPU.
# `openai` : hit any OpenAI-compatible HTTP API (Ollama, Parasail, OpenRouter, vLLM).
MELILO_BACKEND=openai
# Safe for 16GB VRAM running Q4_K_M OLMo 3 7B. Bump to 3-4 if you have more VRAM
# headroom; drop to 1 if you see VRAM pegged in nvidia-smi during a sweep.
MELILO_BACKEND_CONCURRENCY=2
MELILO_BACKEND_MAX_TOKENS=2048
MELILO_BACKEND_TEMPERATURE=0.0

# OpenAI-compatible client config. Defaults below point at a LOCAL OLLAMA:
#   ollama pull olmo-3:7b-instruct
#   (then leave the values below as-is)
#
# To switch to a hosted provider, change OPENAI_BASE_URL + OPENAI_API_KEY + OPENAI_MODEL:
#   Parasail:    OPENAI_BASE_URL=https://api.parasail.io/v1
#                OPENAI_API_KEY=<parasail key>
#                OPENAI_MODEL=allenai/Olmo-3-7B-Instruct  (confirm exact slug in Parasail UI)
#   OpenRouter:  OPENAI_BASE_URL=https://openrouter.ai/api/v1
#                OPENAI_API_KEY=<openrouter key>
#                OPENAI_MODEL=allenai/olmo-3-7b-instruct
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama
OPENAI_MODEL=olmo-3:7b-instruct
